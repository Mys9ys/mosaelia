Options -Indexes

<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</Files>
<Files "config.example.php">
    <IfModule mod_authz_core.c>
        Require all denied
